[Unit]
Description=Nuxt Frontend Service
After=network.target

[Service]
Type=simple
User=nuxtapp
Group=nuxtapp
WorkingDirectory=/home/nuxtapp/app
ExecStart=/usr/bin/node /home/nuxtapp/app/.output/server/index.mjs
Restart=always
RestartSec=5
Environment=NODE_ENV=production PORT=3000 HOST=127.0.0.1

[Install]
WantedBy=multi-user.target