[Unit]
Description=Spring Boot Backend Service
After=network.target postgresql.service

[Service]
Type=simple
User=gamebackend
Group=gamebackend
WorkingDirectory=/home/gamebackend/app
ExecStart=/usr/bin/java -jar /home/gamebackend/app/app.jar
Restart=always
RestartSec=5
Environment=SPRING_PROFILES_ACTIVE=prod

[Install]
WantedBy=multi-user.target